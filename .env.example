# Секретный ключ Flask (обязательно измените!)
SECRET_KEY=change-me-in-production-please

# Режим работы по умолчанию: local | cloud | hybrid
DOCHECK_MODE=local

# Локальная нейросеть (Ollama, llama.cpp server или LM Studio) — OpenAI-совместимый API
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_API_KEY=ollama

# Облачная нейросеть (OpenRouter / Groq / Together / DeepInfra — любые бесплатные модели)
# Для облачного режима нужно указать base_url и api_key провайдера.
CLOUD_LLM_BASE_URL=https://openrouter.ai/api/v1
CLOUD_LLM_API_KEY=

# Учетная запись администратора (создается при первом запуске)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!

# Проверка актуальности НТД
NTD_CHECK_ENABLED=1
NTD_CHECK_INTERVAL_HOURS=24

# Лимит загружаемого файла, МБ
MAX_UPLOAD_MB=100
